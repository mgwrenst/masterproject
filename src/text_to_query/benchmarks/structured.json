  {
    "id": 32,
    "question": "Finn gjennomsnittsalder for politikere som ble innvalgt",
    "category": "aggregate",
    "gold": {
      "op": "aggregate",
      "collection": "personer",
      "pipeline": [
        {
          "$match": {
            "politiker.innvalgt": true,
            "fødselsdato": {
              "$ne": null
            }
          }
        },
        {
          "$project": {
            "alder": {
              "$divide": [
                {
                  "$subtract": [
                    {
                      "$toLong": "$$NOW"
                    },
                    {
                      "$toLong": {
                        "$dateFromString": {
                          "dateString": "$fødselsdato"
                        }
                      }
                    }
                  ]
                },
                31536000000
              ]
            }
          }
        },
        {
          "$group": {
            "_id": null,
            "gjennomsnittsalder": {
              "$avg": "$alder"
            }
          }
        }
      ]
    }
