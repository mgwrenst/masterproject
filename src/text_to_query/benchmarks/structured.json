        }
      ]
    }
  },
  {
    "id": 30,
    "question": "Finn aktive selskaper som har aksjeeierbokoppføringer. Ta med navn og organisasjonsnummer.",
    "category": "quantifier_exists",
    "gold": {
      "op": "aggregate",
      "collection": "aksjeeiebok",
      "pipeline": [
        {
          "$group": {
            "_id": {
              "selskap": "$selskap",
              "orgNr": "$orgNr"
            }
          }
        },
        {
          "$lookup": {
            "from": "selskap",
            "localField": "_id.orgNr",
            "foreignField": "orgNr",
            "as": "selskapDoc"
          }
        },
        {
          "$unwind": "$selskapDoc"
        },
        {
          "$match": {
            "selskapDoc.status.konkursFlagg": 0,
            "selskapDoc.status.likvidasjonFlagg": 0
          }
        },
        {
          "$project": {
            "_id": 0,
            "navn": "$_id.selskap",
            "orgNr": "$_id.orgNr"
          }
        }
      ]
    }
