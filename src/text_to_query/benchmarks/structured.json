  {
    "id": 51,
    "question": "Finn politikere som har selskapsroller. Ta med navn, fødselsdato, parti, selskap og rolle.",
    "category": "lookup_join",
    "gold": {
      "op": "aggregate",
      "collection": "politikere",
      "pipeline": [
        {
          "$lookup": {
            "from": "roller",
            "let": {
              "pnavn": "$navn",
              "pf": "$fødselsdato"
            },
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$and": [
                      {
                        "$eq": [
                          "$navn",
                          "$$pnavn"
                        ]
                      },
                      {
                        "$eq": [
                          "$fødselsdato",
                          "$$pf"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "as": "roller"
          }
        },
        {
          "$unwind": "$roller"
        },
        {
          "$project": {
            "_id": 0,
            "navn": 1,
            "fødselsdato": 1,
            "partinavn": 1,
            "selskap": "$roller.selskapNavn",
            "rolle": "$roller.selskapRolle"
          }
        }
      ]
    }
  },
