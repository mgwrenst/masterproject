  {
    "id": 34,
    "question": "Finn gjennomsnittsalder for innvalgte politikere",
    "category": "aggregate_date_calculation",
    "gold": {
      "op": "aggregate",
      "collection": "personer",
      "pipeline": [
        {
          "$match": {
            "politiker.innvalgt": "Ja",
            "fødselsdato": {
              "$ne": null
            }
          }
        },
        {
          "$project": {
            "alder": {
              "$divide": [
                {
                  "$subtract": [
                    {
                      "$toLong": "$$NOW"
                    },
                    {
                      "$toLong": {
                        "$dateFromString": {
                          "dateString": "$fødselsdato"
                        }
                      }
                    }
                  ]
                },
                31536000000
              ]
            }
          }
        },
        {
          "$group": {
            "_id": null,
            "gjennomsnittsalder": {
              "$avg": "$alder"
            }
          }
        }
      ]
    }
  },
