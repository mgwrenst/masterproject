  {
    "id": 28,
    "question": "Finn personer som både har selskapsrolle og eier aksjer. Ta med navn, fødselsdato, antall roller og antall eide selskaper.",
    "category": "quantifier_exists",
    "gold": {
      "op": "aggregate",
      "collection": "roller",
      "pipeline": [
        {
          "$lookup": {
            "from": "eierskap",
            "let": {
              "pnavn": "$navn",
              "pf": "$fødselsdato"
            },
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$and": [
                      {
                        "$eq": [
                          "$eierPersonNavn",
                          "$$pnavn"
                        ]
                      },
                      {
                        "$eq": [
                          "$eierPersonFødselsdato",
                          "$$pf"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "as": "eierskap"
          }
        },
        {
          "$match": {
            "eierskap.0": {
              "$exists": true
            }
          }
        },
        {
          "$unwind": "$eierskap"
        },
        {
          "$group": {
            "_id": {
              "navn": "$navn",
              "fødselsdato": "$fødselsdato"
            },
            "roller": {
              "$addToSet": "$selskapOrgNr"
            },
            "eideSelskaper": {
              "$addToSet": "$eierskap.utstederOrgNr"
            }
          }
        },
        {
          "$project": {
            "_id": 0,
            "navn": "$_id.navn",
            "fødselsdato": "$_id.fødselsdato",
            "antallRoller": {
              "$size": "$roller"
            },
            "antallEideSelskaper": {
              "$size": "$eideSelskaper"
            }
          }
        }
      ]
    }
  },
  {
    "id": 29,
    "question": "Finn politikere som ikke har registrerte selskapsroller. Ta med navn, fødselsdato og parti.",
