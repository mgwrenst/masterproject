  {
    "id": 19,
    "question": "Finn selskaper som har minst én politiker med selskapsrolle",
    "category": "lookup_or_nested_match",
    "gold": {
      "op": "aggregate",
      "collection": "selskap",
      "pipeline": [
        {
          "$lookup": {
            "from": "personer",
            "localField": "orgNr",
            "foreignField": "selskapOrgNr",
            "as": "roller"
          }
        },
        {
          "$unwind": "$roller"
        },
        {
          "$lookup": {
            "from": "politikere",
            "let": {
              "rnavn": "$roller.navn",
              "rf": "$roller.fødselsdato"
            },
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$and": [
                      {
                        "$eq": [
                          "$navn",
                          "$$rnavn"
                        ]
                      },
                      {
                        "$eq": [
                          "$fødselsdato",
                          "$$rf"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "as": "politikerTreff"
          }
        },
        {
          "$match": {
            "politikerTreff.0": {
              "$exists": true
            }
          }
        },
        {
          "$group": {
            "_id": {
              "navn": "$navn",
              "orgNr": "$orgNr"
            },
            "antallPolitikerRoller": {
              "$sum": 1
            }
          }
        },
        {
          "$project": {
            "_id": 0,
            "navn": "$_id.navn",
            "orgNr": "$_id.orgNr",
            "antallPolitikerRoller": 1
          }
        },
        {
          "$sort": {
            "antallPolitikerRoller": -1
          }
        }
      ]
    }
  },
