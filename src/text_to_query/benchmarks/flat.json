    "id": 15,
    "question": "Finn hvor mange politikere som har hatt minst én selskapsrolle",
    "category": "join_count_or_embedded_count",
    "gold": {
      "op": "aggregate",
      "collection": "politikere",
      "pipeline": [
        {
          "$lookup": {
            "from": "personer",
            "let": {
              "pnavn": "$navn",
              "pf": "$fødselsdato"
            },
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$and": [
                      {
                        "$eq": [
                          "$navn",
                          "$$pnavn"
                        ]
                      },
                      {
                        "$eq": [
                          "$fødselsdato",
                          "$$pf"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "as": "roller"
          }
        },
        {
          "$match": {
            "roller.0": {
              "$exists": true
            }
          }
        },
        {
          "$count": "antallPolitikereMedRoller"
        }
      ]
    }
  },
