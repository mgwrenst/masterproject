      "op": "aggregate",
      "collection": "politikere",
      "pipeline": [
        {
          "$lookup": {
            "from": "eierskap",
            "let": {
              "pnavn": "$navn",
              "pf": "$fødselsdato"
            },
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$and": [
                      {
                        "$eq": [
                          "$eierPersonNavn",
                          "$$pnavn"
                        ]
                      },
                      {
                        "$eq": [
                          "$eierPersonFødselsdato",
                          "$$pf"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "as": "eierskap"
          }
        },
        {
          "$unwind": "$eierskap"
        },
        {
          "$group": {
            "_id": {
              "selskap": "$eierskap.utstederNavn",
              "orgNr": "$eierskap.utstederOrgNr"
            },
            "politikere": {
              "$addToSet": "$navn"
            }
          }
        },
        {
          "$project": {
            "_id": 0,
            "selskap": "$_id.selskap",
            "orgNr": "$_id.orgNr",
            "antallPolitikere": {
              "$size": "$politikere"
            },
            "politikere": 1
          }
        },
        {
          "$sort": {
            "antallPolitikere": -1
          }
        }
      ]
    }
  }
]
